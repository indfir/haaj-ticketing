# Database
DATABASE_URL="postgresql://user:password@localhost:5432/haaj_ticketing?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# HMAC signing for QR payloads
HMAC_SECRET="generate-with-openssl-rand-base64-32"

# Email — Resend (fallback: SMTP)
RESEND_API_KEY=""
EMAIL_FROM="events@example.com"

# SMTP fallback (when RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Chat — Qwen AI (DashScope)
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
